definition
	EVALUATION[at0000] matches {    -- SmokingStatus
		data matches {
			ITEM_TREE[at0002] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- StatusSummary
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,    -- Never
									at0005,    -- Ex
									at0006]    -- Current
								}
							}
						}
					}
					CLUSTER[at0007] occurrences matches {0..1} matches {    -- QuantitySmoked
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0008] occurrences matches {0..1} matches {    -- Cigarettes per day
								value matches {
									DV_QUANTITY matches {*}
								}
							}
							ELEMENT[at0009] occurrences matches {0..1} matches {    -- Cigars per day
								value matches {
									DV_QUANTITY matches {*}
								}
							}
							ELEMENT[at0010] occurrences matches {0..1} matches {    -- Ounces of tobacco
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::124]>
										list = <
											["1"] = <
												units = <"[oz_av]">
											>
										>
									>
								}
							}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {    -- StartDate
						value matches {
							DV_DATE matches {*}
						}
					}
					ELEMENT[at0014] occurrences matches {0..1} matches {    -- StopDate
						value matches {
							DV_DATE matches {*}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0001] matches {*}    -- Item tree
		}
	}

